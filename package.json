{
  "name": "still-pomodoro-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Still: offline-first Pomodoro timer with Android local completion alarms",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:prepare": "npm run build && node scripts/prepare-android.mjs",
    "android:open": "npx cap open android",
    "android:sync": "npm run build && npx cap sync android && node scripts/apply-android-resources.mjs",
    "android:apk": "npm run android:sync && node scripts/build-debug-apk.mjs",
    "test": "node tests/plan.test.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  }
}
